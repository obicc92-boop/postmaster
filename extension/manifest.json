{
  "manifest_version": 3,
  "name": "Postmaster",
  "version": "0.1.0",
  "description": "Lets your local AI agent post to your social accounts through this browser.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://x.com/*", "https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Postmaster", "default_popup": "popup.html" }
}
